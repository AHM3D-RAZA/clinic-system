# ClinicSys staff sign-in. Copy to .env.local (never commit real values),
# or run `npm run auth:demo` to generate a local demo login automatically.

# Secret used to sign session cookies. At least 32 characters; keep it private.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# JSON array of staff accounts. Hash passwords with: npm run auth:hash -- "<password>"
# Leave AUTH_SECRET or this unset and nobody can sign in (the dashboard stays locked).
# STAFF_ACCOUNTS='[{"email":"you@clinic.example","name":"Your Name","title":"Front desk","passwordHash":"scrypt.…"}]'
STAFF_ACCOUNTS=
